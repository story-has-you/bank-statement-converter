{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bank-statement-parser",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "parser.bankstatementconverter.xyz",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "ParserContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PARSER_CONTAINER",
        "class_name": "ParserContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ParserContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
