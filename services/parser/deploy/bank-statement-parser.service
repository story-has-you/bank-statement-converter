[Unit]
Description=Bank Statement Parser
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/apps/parser
EnvironmentFile=/etc/bank-statement-parser.env
ExecStart=/home/ec2-user/apps/parser/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
