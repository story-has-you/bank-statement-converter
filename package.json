{
  "name": "bank-statement-converter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-pdfjs.mjs && node --max-http-header-size=65536 ./node_modules/next/dist/bin/next dev --port 3000",
    "build": "node scripts/prepare-pdfjs.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm test:unit && pnpm verify:pdfjs && pnpm verify:conversion",
    "test:unit": "node --import tsx --test tests/account-summary.test.ts tests/analytics-auth.test.ts tests/billing-quota.test.ts tests/billing-pricing.test.ts tests/conversion-evidence.test.ts tests/conversion-spreadsheet-export.test.tsx tests/merchant-normalization.test.ts tests/public-content.test.ts",
    "test:account": "node --import tsx --test tests/account-summary.test.ts",
    "test:exports": "node --import tsx --test tests/conversion-spreadsheet-export.test.tsx",
    "test:merchants": "node --import tsx --test tests/merchant-normalization.test.ts",
    "test:exports:calc": "node --import tsx --test tests/conversion-spreadsheet-export.calc.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:conversion": "node --import tsx scripts/verify-conversion.mjs",
    "verify:pdfjs": "node --import tsx scripts/verify-pdfjs.mjs",
    "test:billing": "node --import tsx --test tests/billing-quota.test.ts tests/billing-pricing.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "cf:types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-interface CloudflareEnv --include-main-module=false --include-runtime=false --strict-vars=false",
    "cf:build": "NEXT_PUBLIC_APP_ENV=preview opennextjs-cloudflare build && node scripts/cloudflare-env.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/cloudflare-env.mjs --check && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/localizations": "4.26.3",
    "@clerk/nextjs": "^7.10.7",
    "@clerk/ui": "1.44.3",
    "@e965/xlsx": "0.20.3",
    "@next/third-parties": "16.4.6",
    "@opennextjs/cloudflare": "1.20.18",
    "@streamparser/json": "^0.0.26",
    "@waffo/pancake-ts": "0.26.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jotai": "2.20.3",
    "lucide-react": "^1.49.0",
    "next": "16.4.6",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "openai": "^7.31.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261123.1",
    "@next/env": "16.4.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "miniflare": "5.20261123.0-beta",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "4.167.0"
  },
  "packageManager": "pnpm@12.6.0"
}
